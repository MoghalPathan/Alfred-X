# ============================================================
#  DROP-IN SPOTIFY UPGRADE FOR command_handler.py
#  Requires: pip install spotipy
#
#  SETUP:
#  1. Add to your .env file:
#       SPOTIFY_CLIENT_ID=your_client_id
#       SPOTIFY_CLIENT_SECRET=your_client_secret
#       SPOTIFY_REDIRECT_URI=https://localhost:8888/callback
#
#  2. Add to your config.py:
#       SPOTIFY_CLIENT_ID = os.getenv("SPOTIFY_CLIENT_ID", "")
#       SPOTIFY_CLIENT_SECRET = os.getenv("SPOTIFY_CLIENT_SECRET", "")
#       SPOTIFY_REDIRECT_URI = os.getenv("SPOTIFY_REDIRECT_URI", "https://localhost:8888/callback")
#
#  3. In command_handler.py, at the top of the file:
#       from config import ..., SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, SPOTIFY_REDIRECT_URI
#
#  4. FIRST RUN: A browser window will open asking you to log in
#     to Spotify. After you approve, copy the URL from the browser
#     address bar and paste it into the terminal. This only happens ONCE.
#     After that, a .spotify_cache file stores your token automatically.
#
# ============================================================
#
#  SUPPORTED COMMANDS:
#  ─────────────────────────────────────────────────────────
#  "play [song/artist] on spotify"      → search & play
#  "play spotify [song]"                → search & play
#  "pause spotify"                      → pause playback
#  "resume spotify"                     → resume playback
#  "next spotify" / "skip spotify"      → skip to next track
#  "previous spotify" / "back spotify"  → go to previous track
#  "what's playing on spotify"          → show current track
#  "spotify volume 70"                  → set volume (0–100)
#  "shuffle spotify on/off"             → toggle shuffle
#  "repeat spotify on/off"              → toggle repeat
#  "open spotify"                       → open Spotify app
# ============================================================

